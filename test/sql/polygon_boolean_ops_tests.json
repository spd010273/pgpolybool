    "0030":"SELECT public.fn_union_polygons( ARRAY['((0,0),(1,0),(1,1),(0,1))','((1,0),(2,0),(2,1),(1,1))','((1,1),(2,1),(2,2),(1,2))','((0,1),(1,1),(2,1),(2,0))']::POLYGON[] ) <@ '((0,0),(2,0),(2,2),(0,2))'::POLYGON",
