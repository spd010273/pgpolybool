{
    "0010":"SELECT public.fn_intersect_polygons( ARRAY['((0,0),(5,0),(5,5),(0,5))','((4,5),(4,0),(9,0),(9,5))','((0,9),(0,4),(5,4),(5,9))','((9,9),(4,9),(4,4),(9,4))']::POLYGON[] ) ~= '((4,4),(5,4),(5,5),(4,5))'::POLYGON",
